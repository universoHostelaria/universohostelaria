# ─────────────────────────────────────────────────────────────
# Supabase — copie para .env.local e preencha com seus valores
# Settings > API  no painel do Supabase
# ─────────────────────────────────────────────────────────────

# Token de acesso pessoal (sbp_...) — Account > Access Tokens.
# Usado pela Management API para descobrir/popular as chaves abaixo.
SUPABASE_ACCESS_TOKEN=

# URL do projeto (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) — usada no browser, respeita RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — SECRETA, só no servidor. Bypassa RLS.
# Usada pelos scripts de seed e pelo CMS (rotas admin server-side).
SUPABASE_SERVICE_KEY=
